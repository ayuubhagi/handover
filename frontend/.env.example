# Base URL of the FastAPI backend
NEXT_PUBLIC_API_URL=http://localhost:8000
# true = use in-browser fictional demo data (a "Mock data" badge is shown); false = call the real backend
NEXT_PUBLIC_USE_MOCKS=true
# true when the backend runs with DEMO_MODE=true (public demo): roles log in without passcodes
NEXT_PUBLIC_DEMO_MODE=false
# Local only: demo passcodes from the backend .env, u_expert:code,u_successor:code,u_outsider:code (never commit)
NEXT_PUBLIC_DEMO_PASSCODES=
