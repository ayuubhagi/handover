# Copy to .env at the repo root. Never commit .env.

# MongoDB: an Atlas cluster, or a local one with `docker compose up -d mongodb`
# (MONGODB_URI=mongodb://localhost:27017/?directConnection=true)
MONGODB_URI=
MONGODB_DB=handover_dev

# Voyage AI embeddings (voyage-3.5). Without a key a hashed fallback is used (no real semantic search).
VOYAGE_API_KEY=

# LLM: Groq first (openai/gpt-oss-120b, free tier), Gemini as automatic fallback. One key is enough.
GROQ_API_KEY=
GOOGLE_API_KEY=
LLM_PROVIDERS=groq,gemini

# Speech to text: groq (Whisper) or elevenlabs (Scribe). The interviewer's voice is always ElevenLabs.
STT_PROVIDER=groq
ELEVENLABS_API_KEY=

# LangSmith tracing (optional)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true

# Auth: secret for signed tokens, and demo logins as user_id:passcode pairs
AUTH_SECRET=
DEMO_PASSCODES=u_expert:choose-a-code,u_successor:choose-a-code,u_outsider:choose-a-code

# Public demo deploy only: passcode-free role picker, demo reset, and limits that protect the free tiers
DEMO_MODE=false
RATE_LIMIT_PER_MINUTE=20
LLM_DAILY_BUDGET=0
TRUST_PROXY_HEADERS=false
CORS_ORIGINS=*
PUBLIC_BASE_URL=http://localhost:8000
