# Copy to .env at the repo root. Never commit .env.

# MongoDB Atlas
MONGODB_URI=
MONGODB_DB=handover_dev

# Voyage AI embeddings (voyage-3.5)
VOYAGE_API_KEY=

# Gemini (extraction, contradiction checks, answers)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ElevenLabs (speech to text, interviewer voice)
ELEVENLABS_API_KEY=

# LangSmith tracing
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true

# Auth: secret for signed tokens, and demo logins as user_id:passcode pairs
AUTH_SECRET=
DEMO_PASSCODES=u_expert:choose-a-code,u_successor:choose-a-code,u_outsider:choose-a-code
